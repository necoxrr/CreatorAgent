# CreatorAgent 后端环境变量示例
# 复制此文件为 .env 后填入实际值

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-key

# Firecrawl（小红书抓取需要）
FIRECRAWL_API_KEY=

# OpenAI（仅 EMBEDDING_PROVIDER=openai 时需要）
OPENAI_API_KEY=

# Embedding Provider: "local"（默认）| "openai"
EMBEDDING_PROVIDER=local

# 服务配置
HOST=0.0.0.0
PORT=8000
DEBUG=false